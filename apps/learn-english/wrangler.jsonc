{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learn-english",
  // The custom entry (feature 023) routes Arena sockets to their room and the
  // rest to OpenNext's `.open-next/worker.js`.
  "main": "worker.ts",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Plain values (feature 022). `.dev.vars` overrides them locally (BETTER_AUTH_URL=http://localhost:3002).
  // Secrets are set with `wrangler secret put`: STATS_SALT, BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID,
  // GOOGLE_CLIENT_SECRET.
  "vars": {
    "BETTER_AUTH_URL": "https://english.huyle.work"
  },
  // Content, account progress and anonymous stats. Local dev and preview use a
  // local SQLite copy; `--remote` commands hit this database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learn-english",
      "database_id": "6506778f-8d5d-441a-b739-2de8c7b94dc9",
      // drizzle-kit 0.31 writes flat migrations/NNNN_name.sql files, which is
      // wrangler's default layout (no migrations_pattern needed).
      "migrations_dir": "migrations"
    }
  ],
  // Namespace 1001 was the sync-code lookup limiter (removed in feature 037); don't reuse it.
  "ratelimits": [
    // Throttles leaderboard writes per IP (feature 007); a learner posts about once a day.
    {
      "name": "LEADERBOARD_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    },
    // Throttles translation claims and claim status reads per IP (feature 016).
    {
      "name": "CLAIMS_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 }
    },
    // Throttles starting a Google sign-in and its callback per IP (feature 022).
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 20, "period": 60 }
    },
    // Throttles creating and joining Arena rooms per IP (feature 023).
    {
      "name": "ARENA_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 20, "period": 60 }
    },
    // Throttles sending friend requests per IP (feature 031).
    {
      "name": "SOCIAL_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // One live Arena room per room code (feature 023), and one link per signed-in
  // learner that carries friends' challenges to their tabs (feature 035).
  // SQLite-backed: the only storage the Workers free plan allows.
  "durable_objects": {
    "bindings": [
      { "name": "ARENA_ROOM", "class_name": "ArenaRoom" },
      { "name": "LEARNER_LINK", "class_name": "LearnerLink" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ArenaRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["LearnerLink"] }
  ],
  "routes": [{ "pattern": "english.huyle.work", "custom_domain": true }]
}
