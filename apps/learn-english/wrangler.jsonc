{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learn-english",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Content, sync blobs and anonymous stats. The id is replaced with the real
  // one when the database is created (`wrangler d1 create learn-english`);
  // local dev and preview use a local SQLite copy either way.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learn-english",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/*/migration.sql"
    }
  ],
  // Throttles wrong sync-code lookups per IP (brute-force guard).
  "ratelimits": [
    {
      "name": "SYNC_LOOKUP_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "routes": [{ "pattern": "english.huyle.work", "custom_domain": true }]
}
