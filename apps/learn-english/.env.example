# Secrets are Cloudflare bindings, not .env files (OpenNext would inline .env*
# into the Worker bundle). Locally, copy the block below into .dev.vars, which
# both `next dev` and the wrangler preview read. In production:
#   wrangler secret put STATS_SALT
#
# STATS_SALT=replace-with-at-least-32-random-characters
# SYNC_MAX_BYTES=1048576   (optional, defaults to 1 MiB)

# Public base URLs of the audio clips (two static-files-only Workers, see
# audio/*.wrangler.jsonc). Read at build time; these are the defaults.
NEXT_PUBLIC_AUDIO_WORDS_URL=https://audio-words.huyle.work
NEXT_PUBLIC_AUDIO_SENTENCES_URL=https://audio-sentences.huyle.work
