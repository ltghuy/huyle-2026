{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learn-english",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Content, sync blobs and anonymous stats. Local dev and preview use a
  // local SQLite copy; `--remote` commands hit this database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learn-english",
      "database_id": "6506778f-8d5d-441a-b739-2de8c7b94dc9",
      // drizzle-kit 0.31 writes flat migrations/NNNN_name.sql files, which is
      // wrangler's default layout (no migrations_pattern needed).
      "migrations_dir": "migrations"
    }
  ],
  // Throttles wrong sync-code lookups per IP (brute-force guard).
  "ratelimits": [
    {
      "name": "SYNC_LOOKUP_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    // Throttles leaderboard writes per IP (feature 007); a learner posts about once a day.
    {
      "name": "LEADERBOARD_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "routes": [{ "pattern": "english.huyle.work", "custom_domain": true }]
}
