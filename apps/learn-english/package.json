{
  "name": "learn-english",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:deploy:prebuilt": "opennextjs-cloudflare deploy",
    "cf:upload:prebuilt": "opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "content:import": "tsx scripts/import-wordlists.ts",
    "content:ipa": "tsx scripts/build-ipa.ts",
    "content:draft": "tsx scripts/draft-content.ts",
    "content:publish": "tsx scripts/publish-content.ts",
    "content:review": "tsx scripts/review.ts",
    "stats:report": "tsx scripts/stats-report.ts",
    "e2e:seed": "rm -rf .wrangler/e2e && wrangler d1 migrations apply learn-english --local --persist-to .wrangler/e2e && tsx scripts/publish-content.ts --local --persist-to .wrangler/e2e --allow-missing-audio --content-dir scripts/fixtures/content",
    "content:audio": "tsx scripts/generate-audio.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@base-ui/utils": "^0.5.0",
    "@floating-ui/react-dom": "^2.1.9",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "drizzle-orm": "0.45.4",
    "idb": "^8.0.4",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "shadcn": "catalog:",
    "sonner": "^2.0.8",
    "tailwindcss": "catalog:",
    "ts-fsrs": "5.4.2",
    "tw-animate-css": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@breezystack/lamejs": "1.2.7",
    "@opennextjs/cloudflare": "catalog:",
    "@playwright/test": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-kit": "0.31.11",
    "eslint": "catalog:",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "catalog:",
    "kokoro-js": "1.2.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
