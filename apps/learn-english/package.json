{
  "name": "learn-english",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:deploy:prebuilt": "opennextjs-cloudflare deploy",
    "cf:upload:prebuilt": "opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "content:import": "tsx scripts/import-wordlists.ts",
    "content:ipa": "tsx scripts/build-ipa.ts",
    "content:draft": "tsx scripts/draft-content.ts",
    "content:publish": "tsx scripts/publish-content.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@base-ui/utils": "^0.5.0",
    "@floating-ui/react-dom": "^2.1.9",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.4",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "ts-fsrs": "5.4.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@opennextjs/cloudflare": "^1.20.10",
    "@playwright/test": "1.64.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^20.11.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.149.0"
  }
